<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Development helper (not part of the shipped plugin).
    It deserialises ZSZMatch.example.json exactly the way CounterStrikeSharp does and
    prints every value, so a typo in a JSON key is caught immediately instead of
    silently falling back to the default.

    Run it with:  dotnet run (from the tools/ZSZConfigCheck folder)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZSZConfigCheck</AssemblyName>
    <RootNamespace>ZSZConfigCheck</RootNamespace>
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ZSZMatch/ZSZMatch.csproj" />
  </ItemGroup>

</Project>
