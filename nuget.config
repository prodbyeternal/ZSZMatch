<?xml version="1.0" encoding="utf-8"?>
<!--
  The plugin is built against the public CounterStrikeSharp.API package.
  This file makes the restore work on a machine with no NuGet sources configured.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
